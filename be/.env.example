# ---- Runtime ----
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Set true when running behind nginx / a reverse proxy (real client IP for rate limiting)
TRUST_PROXY=false

# ---- Database: PostgreSQL (Neon) ----
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
DB_POOL_MAX=10
# Optional: isolate into a schema (tests set this automatically; uses the unpooled Neon host)
# DB_SCHEMA=

# ---- Auth ----
# 64-char random hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-64-char-hex-secret>
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_PER_MIN=5

# ---- First super admin (npm run seed:admin; idempotent, never resets an existing password) ----
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=<admin-email>
SUPER_ADMIN_PASSWORD=<min-12-chars-strong-password>

# ---- Operations ----
APP_TIMEZONE=Asia/Kolkata
# ---- GPS (see workflow-docs/gps-provider-integration.md for every variable) ----
# simulator (dev/test only) | <real provider adapter name>
GPS_PROVIDER=simulator
GPS_POLL_ENABLED=false
GPS_POLL_INTERVAL_SECONDS=60
GPS_PROVIDER_TIMEOUT_MS=15000
GPS_PROVIDER_TIMEZONE=Asia/Kolkata
GPS_FUTURE_TOLERANCE_SECONDS=120
GPS_STORE_RAW=false
GPS_DEVICE_CACHE_POLLS=10
# Simulator knobs (percentages 0-100)
GPS_SIM_SEED=42
GPS_SIM_SPEED_KMH=15
GPS_SIM_JITTER_M=8
GPS_SIM_DROPOUT_PCT=0
GPS_SIM_DUPLICATE_PCT=0
GPS_SIM_OUT_OF_ORDER_PCT=0
GPS_SIM_LATE_PCT=0
GPS_SIM_BAD_PCT=0
GPS_SIM_OFFLINE_VEHICLES=
GPS_SIM_PLAN_REFRESH_POLLS=10
