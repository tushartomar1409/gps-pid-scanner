# ---- Runtime ----
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Set true when running behind nginx / a reverse proxy (real client IP for rate limiting)
TRUST_PROXY=false

# ---- Database: PostgreSQL (Neon) ----
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
DB_POOL_MAX=10
# Optional: isolate into a schema (tests set this automatically; uses the unpooled Neon host)
# DB_SCHEMA=

# ---- Auth ----
# 64-char random hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-64-char-hex-secret>
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_PER_MIN=5

# ---- First super admin (npm run seed:admin; idempotent, never resets an existing password) ----
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=<admin-email>
SUPER_ADMIN_PASSWORD=<min-12-chars-strong-password>

# ---- Operations ----
APP_TIMEZONE=Asia/Kolkata
# simulator (dev/test only) | <real provider adapter name>
GPS_PROVIDER=simulator
GPS_POLL_INTERVAL_SECONDS=60
