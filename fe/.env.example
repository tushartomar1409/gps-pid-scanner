# Base URL of the backend API. In dev, Vite proxies /api -> http://localhost:5000 (see vite.config.js).
VITE_API_BASE_URL=/api

# Map tiles (any XYZ provider). Defaults: OpenStreetMap standard tiles + attribution.
# Check the provider's usage policy for production traffic (OSM tiles are not for heavy use).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# lat,lng and zoom used when nothing else decides the view
VITE_MAP_DEFAULT_CENTER=28.4082,77.3178
VITE_MAP_DEFAULT_ZOOM=13
# The service-area bbox is NOT configured here: it is loaded from GET /api/settings/public.
